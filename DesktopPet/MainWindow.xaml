<Window x:Class="DesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopPet"
        Width="220"
        Height="220"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">
    <Grid>
        <Image x:Name="PetImage"
               Stretch="Uniform"
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="FlipTransform" ScaleX="1" ScaleY="1" />
                    <ScaleTransform x:Name="ActionScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ActionTranslate" Y="0" />
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Grid>
</Window>
